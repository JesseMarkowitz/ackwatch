# Optional remote compatibility suite. The required local suite provisions its own users.
ACKWATCH_MATRIX_HOMESERVER_URL=
ACKWATCH_MATRIX_MONITOR_USER_ID=
ACKWATCH_MATRIX_MONITOR_PASSWORD=
ACKWATCH_MATRIX_SENDER_A_USER_ID=
ACKWATCH_MATRIX_SENDER_A_PASSWORD=
ACKWATCH_MATRIX_SENDER_B_USER_ID=
ACKWATCH_MATRIX_SENDER_B_PASSWORD=

# Alternative to the six account variables above: with a homeserver URL and a registration
# token, the suite provisions three disposable accounts per run and deactivates them afterwards.
ACKWATCH_MATRIX_REGISTRATION_TOKEN=
